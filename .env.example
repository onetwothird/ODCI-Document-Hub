# ODCI Document Hub - Environment Configuration
# Copy this file to .env and fill in your values

# Application
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/ODCI

# Database
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=odci_db

# Mail Configuration
ODCI_MAIL_DRIVER=smtp
ODCI_SMTP_HOST=smtp.gmail.com
ODCI_SMTP_PORT=587
ODCI_SMTP_USERNAME=your-email@gmail.com
ODCI_SMTP_PASSWORD=your-app-password
ODCI_SMTP_ENCRYPTION=tls
ODCI_MAIL_FROM_ADDRESS=noreply@cvsu.edu.ph
ODCI_MAIL_FROM_NAME=ODCI Document Hub

# For development: use 'log' driver to write emails to storage/logs/mail.log
# ODCI_MAIL_DRIVER=log

# Google OAuth (optional - for social login)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost/ODCI/login/script/google_callback.php

# Session
SESSION_LIFETIME=28800

# Security
HASH_ALGORITHM=sha256
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_TIME=1800